<% layout("/layouts/boilerplate")%>
    <div class="row"></div>
    <div class="col-8" offset="2"></div>
    <h3>Create A New Listing</h3>

    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div>
            <label for="title" class="form-label">Title</label>
            <br>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>

            <div class="valid-feedback">Title looks good!</div>
            <div class="invalid-feedback">title should be valid</div>
        </div>
        <div>
            <label for="description" class="form-label">Description</label>
            <br><textarea name="listing[description]" placeholder="enter description" class="form-control"
                required></textarea>



        </div>


        <div>
            <label for="image"  class="form-label">Upload Image</label>
            <br><input  type="file" name="listing[image]" class="form-control" required>

        </div>

        <div class="row">

            <div class="col-4">
                <label for="price" class="form-label">price</label>
                <br><input name="listing[price]" placeholder="enter price" type="number" class="form-control" required>
                <div class="invalid-feedback">price should be valid</div>
            </div>



            <div class="col-8">
                <label for="country" class="form-label">country</label>
                <br><input name="listing[country]" placeholder="enter country" type="text" class="form-control"
                    required>


                <div class="invalid-feedback">country should be valid</div>
            </div>
        </div>


        <div>
            <label for="location" class="form-label">location</label>
            <br><input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
            <div class="invalid-feedback">location should be valid</div>
        </div>

        <br><br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
    </div>
    </div>